@model SaleManagementSys.Models.OrganizationSettings
@{
    ViewData["Title"] = "Organization Settings";
}
@section Styles {
    <style>
        .org-logo-wrapper { cursor: pointer; }
        .org-logo-circle {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 120px;
            height: 120px;
            border-radius: 50%;
            overflow: hidden;
            background: #e9ecef;
            border: 3px solid #dee2e6;
            transition: border-color 0.2s, background 0.2s;
        }
        .org-logo-wrapper:hover .org-logo-circle {
            border-color: #0d6efd;
            background: #f8f9fa;
        }
        .org-logo-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .org-logo-placeholder {
            color: #6c757d;
            font-size: 0.85rem;
        }
        .org-logo-placeholder i.fa-building { font-size: 2rem; }
    </style>
}

<div class="container-fluid px-4">
    <h2 class="mb-4"><i class="fas fa-building me-2"></i>Organization Settings</h2>

    <form asp-action="Save" method="post" enctype="multipart/form-data" class="card shadow-sm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="LogoUrl" />
        <div class="card-body p-4">
            <div class="text-center mb-4">
                <label class="org-logo-wrapper d-inline-block mb-0" for="orgLogoFile" title="Click to select logo">
                    <span class="org-logo-circle" id="orgLogoCircle">
                        <img id="orgLogoPreview" src="@(Model?.LogoUrl)" alt="Logo" class="org-logo-img @(string.IsNullOrEmpty(Model?.LogoUrl) ? "d-none" : "")" />
                        <span id="orgLogoPlaceholder" class="org-logo-placeholder @(string.IsNullOrEmpty(Model?.LogoUrl) ? "" : "d-none")">
                            <i class="fas fa-building"></i>
                            <span class="small d-block mt-1">Select Logo</span>
                        </span>
                    </span>
                </label>
                <input type="file" id="orgLogoFile" name="LogoFile" accept="image/*" class="d-none" />
            </div>
            <div class="row">
                <div class="col-md-8 mx-auto">
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">Organization Name</label>
                        <input asp-for="Name" class="form-control" maxlength="200" placeholder="Enter organization name" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="PhoneNumber" class="form-label">Phone Number</label>
                        <input asp-for="PhoneNumber" class="form-control" maxlength="20" placeholder="Enter phone number" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Address" class="form-label">Address</label>
                        <textarea asp-for="Address" class="form-control" rows="3" maxlength="500" placeholder="Enter address"></textarea>
                    </div>
                </div>
            </div>
            <div class="text-center mt-4">
                <button type="submit" class="btn btn-primary"><i class="fas fa-save me-2"></i>Save Settings</button>
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-secondary ms-2"><i class="fas fa-arrow-left me-2"></i>Back to Dashboard</a>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        (function () {
            var preview = document.getElementById('orgLogoPreview');
            var placeholder = document.getElementById('orgLogoPlaceholder');
            var fileInput = document.getElementById('orgLogoFile');

            fileInput.addEventListener('change', function () {
                var file = this.files && this.files[0];
                if (file && file.type.startsWith('image/')) {
                    var reader = new FileReader();
                    reader.onload = function (e) {
                        preview.src = e.target.result;
                        preview.classList.remove('d-none');
                        placeholder.classList.add('d-none');
                    };
                    reader.readAsDataURL(file);
                }
            });
        })();
    </script>
}
