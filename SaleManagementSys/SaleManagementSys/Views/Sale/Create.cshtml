@model SaleManagementSys.Models.Sale
@{
    ViewData["Title"] = "Create New Sale";
}

<style>
    body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background-color: #f8f9fa;
    }

    .form-container {
        background: white;
        border-radius: 0.75rem;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        padding: 2rem;
        margin-top: 2rem;
    }

    .form-section {
        margin-bottom: 2rem;
    }

    .section-title {
        font-size: 1.5rem;
        font-weight: 600;
        color: #495057;
        margin-bottom: 1.5rem;
        padding-bottom: 0.5rem;
        border-bottom: 2px solid #e9ecef;
    }

    .table th {
        font-weight: 600;
        color: #495057;
    }

    .table td {
        vertical-align: middle;
    }

    .subtotal-cell {
        font-weight: 600;
        color: #28a745;
    }

    #grandTotal {
        font-size: 1.25rem;
        font-weight: 700;
        color: #007bff;
    }

    .btn-add-item {
        border-radius: 0.5rem;
        margin-bottom: 1rem;
    }

    .form-label {
        font-weight: 600;
        color: #495057;
        margin-bottom: 0.5rem;
    }

    .form-control, .form-select {
        border-radius: 0.5rem;
        border: 1px solid #ced4da;
    }

    .form-control:focus, .form-select:focus {
        border-color: #667eea;
        box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
    }

    .btn-submit {
        border-radius: 0.5rem;
        padding: 0.75rem 2rem;
        font-weight: 600;
    }

    .btn-cancel {
        border-radius: 0.5rem;
        padding: 0.75rem 2rem;
        font-weight: 600;
    }
</style>

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>
            <i class="fas fa-plus-circle me-2"></i>Create New Sale
        </h2>
        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-secondary btn-cancel">
            <i class="fas fa-arrow-left me-2"></i>Back to Dashboard
        </a>
    </div>

    <div class="form-container">
        <form asp-controller="Sale" asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="alert alert-danger mb-3" role="alert"></div>

            <!-- Customer Information Section -->
            <div class="form-section">
                <h3 class="section-title">
                    <i class="fas fa-user me-2"></i>Customer Information
                </h3>
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="CustomerName" class="form-label"></label>
                        <input asp-for="CustomerName" class="form-control" placeholder="Enter customer name" />
                        <span asp-validation-for="CustomerName" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="PhoneNumber" class="form-label"></label>
                        <input asp-for="PhoneNumber" class="form-control" placeholder="Enter phone number" />
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="SaleDate" class="form-label"></label>
                        <input asp-for="SaleDate" class="form-control" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="SaleDate" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <!-- Sale Items Section -->
            <div class="form-section">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="section-title mb-0">
                        <i class="fas fa-box me-2"></i>Sale Items
                    </h3>
                    <button type="button" class="btn btn-success btn-add-item" id="addSaleItem">
                        <i class="fas fa-plus me-2"></i>Add Item
                    </button>
                </div>

                <div class="table-responsive">
                    <table class="table table-bordered table-hover" id="saleItemsTable">
                        <thead class="table-light">
                            <tr>
                                <th>Product Name</th>
                                <th class="text-end">Quantity</th>
                                <th class="text-end">Sale Price</th>
                                <th class="text-end">Purchase Price</th>
                                <th class="text-end">SubTotal</th>
                                <th class="text-center" style="width: 100px;">Action</th>
                            </tr>
                        </thead>
                        <tbody id="saleItemsContainer">
                            <!-- Sale items will be added here dynamically -->
                        </tbody>
                        <tfoot>
                            <tr class="table-info">
                                <th colspan="4" class="text-end"><strong>Grand Total:</strong></th>
                                <th class="text-end" id="grandTotal">0.00</th>
                                <th></th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            <!-- Hidden fields for TotalAmount and TotalProfit (calculated automatically) -->
            <input asp-for="TotalAmount" type="hidden" />
            <input asp-for="TotalProfit" type="hidden" />

            <!-- Submit Buttons -->
            <div class="d-flex justify-content-end gap-2 mt-4">
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-secondary btn-cancel">
                    Cancel
                </a>
                <button type="submit" class="btn btn-primary">Create</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        let saleItemIndex = 0;

        // Add new sale item row
        document.getElementById('addSaleItem').addEventListener('click', function() {
            const tbody = document.getElementById('saleItemsContainer');
            const index = saleItemIndex++;
            
            const row = document.createElement('tr');
            row.setAttribute('data-index', index);
            row.innerHTML = `
                <td>
                    <input name="SaleDetails[${index}].ProductName" class="form-control form-control-sm product-name" placeholder="Enter product name" required />
                </td>
                <td>
                    <input name="SaleDetails[${index}].Quantity" type="number" min="1" class="form-control form-control-sm quantity text-end" placeholder="1" value="1" required />
                </td>
                <td>
                    <input name="SaleDetails[${index}].SalePrice" type="number" step="0.01" min="0" class="form-control form-control-sm sale-price text-end" placeholder="0.00" required />
                </td>
                <td>
                    <input name="SaleDetails[${index}].PurchasePrice" type="number" step="0.01" min="0" class="form-control form-control-sm purchase-price text-end" placeholder="0.00" />
                </td>
                <td class="text-end subtotal-cell" data-subtotal="0.00">0.00</td>
                <td class="text-center">
                    <button type="button" class="btn btn-danger btn-sm btn-remove" onclick="removeSaleItem(this)">
                        <i class="fas fa-trash"></i>
                    </button>
                </td>
            `;
            
            tbody.appendChild(row);
            updateIndexes();
            attachCalculationListeners(row);
        });

        // Remove sale item row
        function removeSaleItem(button) {
            const row = button.closest('tr');
            row.remove();
            updateIndexes();
            calculateTotals();
        }

        // Update indexes after removal
        function updateIndexes() {
            const rows = document.querySelectorAll('#saleItemsContainer tr');
            rows.forEach((row, index) => {
                const inputs = row.querySelectorAll('input');
                inputs.forEach(input => {
                    const name = input.name;
                    if (name) {
                        input.name = name.replace(/SaleDetails\[\d+\]/, `SaleDetails[${index}]`);
                    }
                });
                row.setAttribute('data-index', index);
            });
        }

        // Attach calculation listeners to a row
        function attachCalculationListeners(row) {
            const quantityInput = row.querySelector('.quantity');
            const salePriceInput = row.querySelector('.sale-price');
            const purchasePriceInput = row.querySelector('.purchase-price');
            
            [quantityInput, salePriceInput, purchasePriceInput].forEach(input => {
                input.addEventListener('input', function() {
                    calculateRowSubTotal(row);
                    calculateTotals();
                });
            });
        }

        // Calculate subtotal for a single row
        function calculateRowSubTotal(row) {
            const quantity = parseFloat(row.querySelector('.quantity').value) || 0;
            const salePrice = parseFloat(row.querySelector('.sale-price').value) || 0;
            const subtotal = quantity * salePrice;
            
            const subtotalCell = row.querySelector('[data-subtotal]');
            subtotalCell.textContent = subtotal.toFixed(2);
            subtotalCell.setAttribute('data-subtotal', subtotal.toFixed(2));
        }

        // Calculate grand total and update hidden fields
        function calculateTotals() {
            let grandTotal = 0;
            let totalProfit = 0;
            
            document.querySelectorAll('#saleItemsContainer tr').forEach(row => {
                const quantity = parseFloat(row.querySelector('.quantity').value) || 0;
                const salePrice = parseFloat(row.querySelector('.sale-price').value) || 0;
                const purchasePrice = parseFloat(row.querySelector('.purchase-price').value) || 0;
                
                const subtotal = quantity * salePrice;
                const profit = (salePrice - purchasePrice) * quantity;
                
                grandTotal += subtotal;
                totalProfit += profit;
            });
            
            // Update grand total display
            document.getElementById('grandTotal').textContent = grandTotal.toFixed(2);
            
            // Update hidden fields
            document.querySelector('[name="TotalAmount"]').value = grandTotal.toFixed(2);
            document.querySelector('[name="TotalProfit"]').value = totalProfit.toFixed(2);
        }

        // Add first sale item on page load
        document.addEventListener('DOMContentLoaded', function() {
            document.getElementById('addSaleItem').click();
        });
    </script>
}
