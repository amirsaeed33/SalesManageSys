@model List<SaleManagementSys.Models.Sale>
@{
    ViewData["Title"] = "Sales List";
}

<style>
    body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background-color: #f8f9fa;
    }

    .sales-table-container {
        background: white;
        border-radius: 0.75rem;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        padding: 1.5rem;
        margin-top: 2rem;
    }

    .table {
        margin-bottom: 0;
    }

    .table thead th {
        background-color: #f8f9fa;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.85rem;
        letter-spacing: 0.5px;
        border-bottom: 2px solid #dee2e6;
        color: #495057;
    }

    .table tbody tr {
        transition: background-color 0.2s;
    }

    .table tbody tr:hover {
        background-color: #f8f9fa;
    }

    .action-buttons {
        white-space: nowrap;
    }

    .action-buttons .btn {
        margin-right: 5px;
    }

    .action-buttons .btn:last-child {
        margin-right: 0;
    }
</style>

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>
            <i class="fas fa-list me-2"></i>Sales List
        </h2>
        <a asp-controller="Sale" asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus-circle me-2"></i>Create New Sale
        </a>
    </div>

    <div class="sales-table-container">
        <div class="table-responsive">
            <table class="table table-striped table-hover table-bordered">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Customer Name</th>
                        <th>Phone</th>
                        <th>Total Amount</th>
                        <th>Total Profit</th>
                        <th>Sale Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        var index = 1;
                        @foreach (var sale in Model)
                        {
                            <tr>
                                <td>@index</td>
                                <td>@(sale?.CustomerName ?? "N/A")</td>
                                <td>@(sale?.PhoneNumber ?? "N/A")</td>
                                <td class="fw-bold text-success">@(sale?.TotalAmount.ToString("C") ?? "$0.00")</td>
                                <td class="fw-bold text-primary">@(sale?.TotalProfit.ToString("C") ?? "$0.00")</td>
                                <td>@(sale?.SaleDate.ToString("MM/dd/yyyy") ?? "N/A")</td>
                                <td class="action-buttons">
                                    @if (sale != null)
                                    {
                                        <a asp-controller="Sale" asp-action="Print" asp-route-id="@sale.Id" class="btn btn-sm btn-secondary" title="Print Invoice" target="_blank">
                                            <i class="fas fa-print"></i>
                                        </a>
                                        <a asp-controller="Sale" asp-action="Details" asp-route-id="@sale.Id" class="btn btn-sm btn-info" title="View Details">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-controller="Sale" asp-action="Edit" asp-route-id="@sale.Id" class="btn btn-sm btn-warning" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <form id="delete-sale-@sale.Id" asp-controller="Sale" asp-action="Delete" asp-route-id="@sale.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="button" class="btn btn-sm btn-danger" title="Delete" onclick="showDeleteConfirm('delete-sale-@sale.Id', 'Are you sure you want to delete this sale?');"><i class="fas fa-trash"></i></button>
                                        </form>
                                    }
                                </td>
                            </tr>
                            index++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4">
                                <i class="fas fa-inbox fa-3x text-muted mb-3 d-block"></i>
                                <p class="text-muted">No sales records found.</p>
                                <a asp-controller="Sale" asp-action="Create" class="btn btn-primary">
                                    <i class="fas fa-plus-circle me-2"></i>Create Your First Sale
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
