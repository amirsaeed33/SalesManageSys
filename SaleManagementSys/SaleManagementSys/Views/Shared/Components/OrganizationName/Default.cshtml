@model SaleManagementSys.ViewComponents.OrganizationNameViewComponent.OrganizationBrandViewModel
@if (Model.ShowLogo)
{
    <span class="navbar-brand-circle">
        @if (!string.IsNullOrWhiteSpace(Model.LogoUrl))
        {
            <img src="@Model.LogoUrl" alt="@Model.Name" class="navbar-brand-circle-img" />
        }
        else
        {
            <span class="navbar-brand-initials">@Model.Initials</span>
        }
    </span>
}
else
{
    @Model.Name
}
