@model List<SaleManagementSys.Models.Order>
@using System.Globalization
@using SaleManagementSys.Helpers
@{
    ViewData["Title"] = "Orders";
    var pkrCulture = CurrencyHelper.PkrCulture;
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-clipboard-list me-2"></i>Orders</h2>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Customer</th>
                    <th>Phone</th>
                    <th>Address</th>
                    <th class="text-end">Total</th>
                    <th>Order Date</th>
                    <th>Status</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    var i = 1;
                    foreach (var o in Model)
                    {
                        <tr>
                            <td>@i</td>
                            <td>@o.CustomerName</td>
                            <td>@(o.PhoneNumber ?? "—")</td>
                            <td>@(string.IsNullOrWhiteSpace(o.Address) ? "—" : (o.Address.Length > 40 ? o.Address.Substring(0, 40) + "…" : o.Address))</td>
                            <td class="text-end fw-bold text-success">@o.TotalAmount.ToString("C", pkrCulture)</td>
                            <td>@o.OrderDate.ToString("MM/dd/yyyy hh:mm tt")</td>
                            <td>
                                @if (o.Status == SaleManagementSys.Models.OrderStatus.Pending)
                                { <span class="badge bg-warning text-dark">Pending</span> }
                                else if (o.Status == SaleManagementSys.Models.OrderStatus.Processed)
                                { <span class="badge bg-success">Processed</span> }
                                else
                                { <span class="badge bg-secondary">@o.Status</span> }
                            </td>
                            <td class="text-center">
                                @if (o.Status == SaleManagementSys.Models.OrderStatus.Pending)
                                {
                                    <form asp-action="Process" asp-route-id="@o.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-success" title="Process order (create sale and reduce stock)">
                                            <i class="fas fa-check me-1"></i>Process
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                        </tr>
                        i++;
                    }
                }
                else
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">No orders. Orders from the Store catalog appear here; process them to create a sale and update stock.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
