@{
    ViewData["Title"] = "Sign In";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="auth-container" id="authContainer">
    <div class="auth-slider">
        <!-- Panel 1: Login -->
        <div class="auth-panel auth-panel-login">
            <div class="auth-panel-half auth-panel-dark">
                <div class="auth-card auth-card-glass">
                    <h2 class="auth-title">Login</h2>
                    <form method="post" action="#" class="auth-form" id="loginForm">
                        <div id="loginError" class="auth-message auth-message-error" style="display: none;"></div>
                        <div class="auth-input-wrap">
                            <input type="text" name="username" id="loginUsername" placeholder="Username" class="auth-input" autocomplete="username" required />
                            <i class="fas fa-user auth-input-icon"></i>
                        </div>
                        <div class="auth-input-wrap">
                            <input type="password" name="password" id="loginPassword" placeholder="Password" class="auth-input" autocomplete="current-password" required />
                            <i class="fas fa-lock auth-input-icon"></i>
                            <button type="button" class="auth-password-toggle" aria-label="Show password" data-target="loginPassword" title="Show password">
                                <i class="fas fa-eye auth-password-toggle-show"></i>
                                <i class="fas fa-eye-slash auth-password-toggle-hide" style="display: none;"></i>
                            </button>
                        </div>
                        <button type="submit" class="auth-btn auth-btn-glow" id="loginBtn">Login</button>
                    </form>
                    <p class="auth-switch-text">Don't have an account? <a href="#" class="auth-switch-link" id="signUp">Sign Up</a></p>
                </div>
            </div>
            <div class="auth-panel-half auth-panel-orange">
                <div class="auth-welcome">
                    <h2 class="auth-welcome-title">WELCOME BACK!</h2>
                    <p class="auth-welcome-desc">We are happy to have you with us again. If you need anything, we are here to help.</p>
                </div>
            </div>
        </div>

        <!-- Panel 2: Register -->
        <div class="auth-panel auth-panel-register">
            <div class="auth-panel-half auth-panel-orange">
                <div class="auth-welcome">
                    <h2 class="auth-welcome-title">WELCOME!</h2>
                    <p class="auth-welcome-desc">We're delighted to have you here. If you need any assistance, feel free to reach out.</p>
                </div>
            </div>
            <div class="auth-panel-half auth-panel-dark">
                <div class="auth-card auth-card-glass">
                    <h2 class="auth-title">Register</h2>
                    <form method="post" action="#" class="auth-form" id="registerForm">
                        <div id="registerError" class="auth-message auth-message-error" style="display: none;"></div>
                        <div class="auth-input-wrap">
                            <input type="text" name="username" id="regUsername" placeholder="Username" class="auth-input" autocomplete="username" required />
                            <i class="fas fa-user auth-input-icon"></i>
                        </div>
                        <div class="auth-input-wrap">
                            <input type="email" name="email" id="regEmail" placeholder="Email" class="auth-input" autocomplete="email" required />
                            <i class="fas fa-envelope auth-input-icon"></i>
                        </div>
                        <div class="auth-input-wrap">
                            <input type="password" name="password" id="regPassword" placeholder="Password" class="auth-input" autocomplete="new-password" required minlength="6" />
                            <i class="fas fa-lock auth-input-icon"></i>
                            <button type="button" class="auth-password-toggle" aria-label="Show password" data-target="regPassword" title="Show password">
                                <i class="fas fa-eye auth-password-toggle-show"></i>
                                <i class="fas fa-eye-slash auth-password-toggle-hide" style="display: none;"></i>
                            </button>
                        </div>
                        <button type="submit" class="auth-btn auth-btn-glow" id="registerBtn">Register</button>
                    </form>
                    <p class="auth-switch-text">Already have an account? <a href="#" class="auth-switch-link" id="signIn">Sign In</a></p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/auth.js" asp-append-version="true"></script>
}
