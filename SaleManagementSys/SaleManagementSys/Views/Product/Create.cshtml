@model SaleManagementSys.Models.Product
@{
    ViewData["Title"] = "Add Product";
}

<div class="container-fluid px-4">
    <h2 class="mb-4"><i class="fas fa-plus me-2"></i>Add Product</h2>

    <form asp-action="Create" method="post" class="card card-body col-md-6">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="DefaultPurchasePrice" class="form-label"></label>
            <input asp-for="DefaultPurchasePrice" class="form-control" type="number" step="0.01" min="0" />
            <span asp-validation-for="DefaultPurchasePrice" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="2"></textarea>
        </div>
        <div>
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
