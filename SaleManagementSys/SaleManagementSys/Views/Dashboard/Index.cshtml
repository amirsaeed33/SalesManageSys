@model DashboardViewModel
@{
    ViewData["Title"] = "Sales Management Dashboard";
}
@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<!-- Top Navbar -->
<nav class="navbar navbar-expand-lg navbar-custom mb-4">
    <div class="container-fluid px-4">
        <a class="navbar-brand" href="#">
            <i class="fas fa-chart-line me-2"></i>Sales Management Dashboard
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <a class="nav-link" href="#">
                        <i class="fas fa-user-circle user-icon"></i>
                    </a>
                </li>
            </ul>
        </div>
    </div>
</nav>

<div class="container-fluid px-4">
    <!-- Dashboard Cards Section -->
    <div class="row g-4 mb-4">
        @foreach (var card in Model.Cards)
        {
            <div class="col-md-4 col-sm-6">
                <div class="card dashboard-card @card.GradientCssClass text-white">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <p class="card-label mb-2">@card.Label</p>
                                <h2 class="card-value">@card.Value</h2>
                            </div>
                            <div class="card-icon">
                                <i class="@card.IconCssClass"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Sales Table Section -->
    <div class="sales-table-container">
        <h3 class="mb-4">
            <i class="fas fa-list me-2"></i>Sales Records
        </h3>
        <div class="table-responsive">
            <table class="table table-striped table-hover table-bordered">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Customer Name</th>
                        <th>Phone</th>
                        <th>Total Amount</th>
                        <th>Total Profit</th>
                        <th>Sale Date</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model?.Sales != null && Model.Sales.Any())
                    {
                        var index = 1;
                        @foreach (var sale in Model.Sales)
                        {
                            <tr>
                                <td>@index</td>
                                <td>@(sale?.CustomerName ?? "N/A")</td>
                                <td>@(sale?.PhoneNumber ?? "N/A")</td>
                                <td class="fw-bold text-success">@(sale?.TotalAmount.ToString("C") ?? "$0.00")</td>
                                <td class="fw-bold text-primary">@(sale?.TotalProfit.ToString("C") ?? "$0.00")</td>
                                <td>@(sale?.SaleDate.ToString("MM/dd/yyyy") ?? "N/A")</td>
                                <td class="action-buttons">
                                    @if (sale != null)
                                    {
                                        <a asp-controller="Sale" asp-action="Details" asp-route-id="@sale.Id" class="btn btn-sm btn-info" title="View Details">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-controller="Sale" asp-action="Edit" asp-route-id="@sale.Id" class="btn btn-sm btn-warning" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <form id="delete-sale-@sale.Id" asp-controller="Sale" asp-action="Delete" asp-route-id="@sale.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="button" class="btn btn-sm btn-danger" title="Delete" onclick="showDeleteConfirm('delete-sale-@sale.Id', 'Are you sure you want to delete this sale?');"><i class="fas fa-trash"></i></button>
                                        </form>
                                    }
                                </td>
                            </tr>
                            index++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4">
                                <i class="fas fa-inbox fa-3x text-muted mb-3 d-block"></i>
                                <p class="text-muted">No sales records found. Create your first sale!</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Add any custom JavaScript here if needed
        $(document).ready(function() {
            // Optional: Add animations or interactions
        });
    </script>
}
