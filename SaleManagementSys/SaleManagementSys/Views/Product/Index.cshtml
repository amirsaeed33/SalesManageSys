@model List<SaleManagementSys.Models.Product>
@{
    ViewData["Title"] = "Products";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-box me-2"></i>Products</h2>
        <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus me-2"></i>Add Product</a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Name</th>
                    <th>Default Purchase Price</th>
                    <th>Description</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    var i = 1;
                    foreach (var p in Model)
                    {
                        <tr>
                            <td>@i</td>
                            <td>@p.Name</td>
                            <td>@p.DefaultPurchasePrice.ToString("C")</td>
                            <td>@(p.Description ?? "—")</td>
                        </tr>
                        i++;
                    }
                }
                else
                {
                    <tr><td colspan="4" class="text-center text-muted">No products. <a asp-action="Create">Add one</a>.</td></tr>
                }
            </tbody>
        </table>
    </div>
    <p class="mt-2">
        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-secondary">Back to Dashboard</a>
    </p>
</div>
