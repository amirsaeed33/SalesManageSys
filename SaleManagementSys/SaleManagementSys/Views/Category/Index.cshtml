@model List<SaleManagementSys.Models.Category>
@{
    ViewData["Title"] = "Categories";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-tags me-2"></i>Categories</h2>
        <button type="button" class="btn btn-primary" onclick="categoryModal.open();">
            <i class="fas fa-plus me-2"></i>Add Category
        </button>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th style="width: 90px;">Id</th>
                    <th>Name</th>
                    <th>Description</th>
                    <th class="text-center col-action">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var c in Model)
                    {
                        <tr data-id="@c.Id" data-name="@c.Name" data-description="@(c.Description ?? "")">
                            <td>@c.Id</td>
                            <td>@c.Name</td>
                            <td>@(string.IsNullOrWhiteSpace(c.Description) ? "—" : c.Description)</td>
                            <td class="text-center">
                                <button type="button" class="btn btn-sm btn-outline-primary me-1" title="Edit" onclick="categoryModal.open(this.closest('tr'));">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <form id="delete-category-@c.Id" asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="button" class="btn btn-sm btn-danger" title="Delete" onclick="showDeleteConfirm('delete-category-@c.Id', 'Are you sure you want to delete this category?');">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="4" class="text-center text-muted">No categories yet.</td></tr>
                }
            </tbody>
        </table>
    </div>

    <p class="mt-2">
        <a asp-controller="Product" asp-action="Index" class="btn btn-secondary">Back to Products</a>
    </p>
</div>

<div class="modal fade" id="categoryFormModal" tabindex="-1" aria-labelledby="categoryFormModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="categoryFormModalLabel">
                    <i class="fas fa-tags me-2"></i><span id="categoryFormModalTitle">Add Category</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="categoryForm" method="post" asp-action="Save">
                @Html.AntiForgeryToken()
                <input type="hidden" id="categoryId" name="Id" value="0" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="categoryName" class="form-label">Category Name</label>
                        <input type="text" id="categoryName" name="Name" class="form-control" required maxlength="200" placeholder="Enter category name" />
                    </div>
                    <div class="mb-3">
                        <label for="categoryDescription" class="form-label">Description</label>
                        <textarea id="categoryDescription" name="Description" class="form-control" rows="3" maxlength="1000" placeholder="Optional"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i><span id="categoryFormSubmitText">Save</span></button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var modalEl = document.getElementById('categoryFormModal');
            var titleEl = document.getElementById('categoryFormModalTitle');
            var submitTextEl = document.getElementById('categoryFormSubmitText');
            var modalInstance = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);

            window.categoryModal = {
                open: function (row) {
                    if (!row) {
                        document.getElementById('categoryId').value = '0';
                        document.getElementById('categoryName').value = '';
                        document.getElementById('categoryDescription').value = '';
                        titleEl.textContent = 'Add Category';
                        submitTextEl.textContent = 'Save';
                    } else {
                        document.getElementById('categoryId').value = row.dataset.id || '0';
                        document.getElementById('categoryName').value = row.dataset.name || '';
                        document.getElementById('categoryDescription').value = row.dataset.description || '';
                        titleEl.textContent = 'Edit Category';
                        submitTextEl.textContent = 'Update';
                    }
                    modalInstance.show();
                }
            };
        })();
    </script>
}

