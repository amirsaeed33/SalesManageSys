@model List<SaleManagementSys.Models.Sale>
@using System.Globalization
@{
    var index = 1;
    var pkrCulture = CultureInfo.GetCultureInfo("en-PK");
}
@if (Model != null && Model.Any())
{
    @foreach (var sale in Model)
    {
        <tr data-search="@((sale?.CustomerName ?? "") + " " + (sale?.PhoneNumber ?? "") + " " + (sale?.TotalAmount.ToString("N2") ?? "") + " " + (sale?.SaleDate.ToString("MM/dd/yyyy") ?? ""))">
            <td>@(index++)</td>
            <td>@(sale?.CustomerName ?? "N/A")</td>
            <td>@(sale?.PhoneNumber ?? "N/A")</td>
            <td class="fw-bold text-success">@(sale?.TotalAmount.ToString("C", pkrCulture) ?? "Rs. 0.00")</td>
            <td class="fw-bold text-primary">@(sale?.TotalProfit.ToString("C", pkrCulture) ?? "Rs. 0.00")</td>
            <td>@(sale?.SaleDate.ToString("MM/dd/yyyy") ?? "N/A")</td>
            <td class="action-buttons">
                @if (sale != null)
                {
                    <a asp-controller="Sale" asp-action="Print" asp-route-id="@sale.Id" class="btn btn-sm btn-secondary" title="Print Invoice" target="_blank">
                        <i class="fas fa-print"></i>
                    </a>
                    <a asp-controller="Sale" asp-action="Details" asp-route-id="@sale.Id" class="btn btn-sm btn-info" title="View Details">
                        <i class="fas fa-eye"></i>
                    </a>
                    <a asp-controller="Sale" asp-action="Edit" asp-route-id="@sale.Id" class="btn btn-sm btn-warning" title="Edit">
                        <i class="fas fa-edit"></i>
                    </a>
                    <form id="delete-sale-@sale.Id" asp-controller="Sale" asp-action="Delete" asp-route-id="@sale.Id" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="button" class="btn btn-sm btn-danger" title="Delete" onclick="showDeleteConfirm('delete-sale-@sale.Id', 'Are you sure you want to delete this sale?');"><i class="fas fa-trash"></i></button>
                    </form>
                }
            </td>
        </tr>
    }
    <tr id="saleNoResultsRow" class="d-none">
        <td colspan="7" class="text-center py-4">
            <i class="fas fa-search fa-3x text-muted mb-3 d-block"></i>
            <p class="text-muted mb-0">No matching sales found.</p>
        </td>
    </tr>
}
else
{
    <tr id="saleEmptyRow">
        <td colspan="7" class="text-center py-4">
            <i class="fas fa-inbox fa-3x text-muted mb-3 d-block"></i>
            <p class="text-muted mb-0">No sales records found.</p>
        </td>
    </tr>
}
