<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @(await Component.InvokeAsync("OrganizationName"))</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/spider-cursor.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <canvas id="spiderCanvas"></canvas>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <div id="navbarUserBlock" class="d-flex align-items-center me-3" style="display: none !important;">
                    <div class="dropdown">
                        <button class="btn btn-link p-0 text-decoration-none d-flex align-items-center text-dark dropdown-toggle" type="button" id="navbarUserDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <span id="navbarUserCircle" class="navbar-brand-circle me-2"></span>
                            <span id="navbarUserName" class="fw-medium"></span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-start" aria-labelledby="navbarUserDropdown">
                            <li><a class="dropdown-item" href="#" id="navbarLogoutBtn"><i class="fas fa-sign-out-alt me-2"></i>Logout</a></li>
                        </ul>
                    </div>
                </div>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-center flex-grow-1">
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Dashboard" asp-action="Index"><i class="fas fa-home me-1"></i>Dashboard</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Order" asp-action="Index"><i class="fas fa-clipboard-list me-1"></i>Orders</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Sale" asp-action="Index"><i class="fas fa-shopping-cart me-1"></i>Sales</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Product" asp-action="Index"><i class="fas fa-box me-1"></i>Products</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Product" asp-action="Catalog"><i class="fas fa-store me-1"></i>Store</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="OrganizationSettings" asp-action="Index"><i class="fas fa-cog me-1"></i>Organization</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Delete confirmation modal (replaces browser confirm) -->
    <div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-labelledby="deleteConfirmModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteConfirmModalLabel">
                        <i class="fas fa-exclamation-triangle text-warning me-2"></i>Confirm Delete
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p id="deleteConfirmMessage" class="mb-0">Are you sure you want to delete this?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No, Cancel</button>
                    <button type="button" class="btn btn-danger" id="deleteConfirmYesBtn">
                        <i class="fas fa-trash me-1"></i>Yes, Delete
                    </button>
                </div>
            </div>
        </div>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - @(await Component.InvokeAsync("OrganizationName")) - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/spider-cursor.js" asp-append-version="true"></script>
    <script>
        // Navbar user block: show username + initials, logout dropdown (left side only)
        (function () {
            var block = document.getElementById('navbarUserBlock');
            var circleEl = document.getElementById('navbarUserCircle');
            var nameEl = document.getElementById('navbarUserName');
            var logoutBtn = document.getElementById('navbarLogoutBtn');
            if (!block || !circleEl || !nameEl) return;
            var token = localStorage.getItem('authToken');
            if (!token) return;
            var username = localStorage.getItem('authUsername');
            if (!username) {
                try {
                    var payload = token.split('.')[1];
                    if (payload) {
                        var json = JSON.parse(atob(payload.replace(/-/g, '+').replace(/_/g, '/')));
                        username = json.unique_name || json['http://schemas.xmlsoap.org/ws/2005/05/identity/claims/name'] || json.sub || '';
                        if (username) localStorage.setItem('authUsername', username);
                    }
                } catch (e) { }
            }
            if (!username) return;
            var words = username.trim().split(/\s+/);
            var initial = words[0] ? words[0].charAt(0).toUpperCase() : '';
            if (words.length > 1 && words[1][0]) initial += words[1].charAt(0).toUpperCase();
            else if (words[0] && words[0].length > 1) initial = words[0].substring(0, 2).toUpperCase();
            circleEl.innerHTML = '<span class="navbar-brand-initials">' + (initial || '?') + '</span>';
            circleEl.className = 'navbar-brand-circle me-2';
            nameEl.textContent = username;
            block.style.display = '';
            if (logoutBtn) {
                logoutBtn.addEventListener('click', function (e) {
                    e.preventDefault();
                    localStorage.removeItem('authToken');
                    localStorage.removeItem('authUsername');
                    window.location.href = '/Home/Login';
                });
            }
        })();
    </script>
    <script>
        // Delete confirmation dialog (used by Sale and Product delete buttons)
        var deleteConfirmFormId = null;
        function showDeleteConfirm(formId, message) {
            deleteConfirmFormId = formId;
            document.getElementById('deleteConfirmMessage').textContent = message || 'Are you sure you want to delete this?';
            var modalEl = document.getElementById('deleteConfirmModal');
            var modal = new bootstrap.Modal(modalEl);
            modal.show();
        }
        document.addEventListener('DOMContentLoaded', function () {
            document.getElementById('deleteConfirmYesBtn').addEventListener('click', function () {
                if (deleteConfirmFormId) {
                    var form = document.getElementById(deleteConfirmFormId);
                    if (form) form.submit();
                    deleteConfirmFormId = null;
                }
                var modalEl = document.getElementById('deleteConfirmModal');
                var modal = bootstrap.Modal.getInstance(modalEl);
                if (modal) modal.hide();
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
