@model List<SaleManagementSys.Models.Product>
@using System.Globalization
@{
    ViewData["Title"] = "Products";
    var pkrCulture = CultureInfo.GetCultureInfo("en-PK");
}

<div class="container-fluid px-4 py-4">
    <h2 class="mb-4"><i class="fas fa-store me-2"></i>Our Products</h2>

    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            @foreach (var product in Model)
            {
                <div class="col-md-4 col-sm-6 col-lg-3">
                    <div class="card product-card h-100 shadow-sm">
                        <div class="product-card-image-wrapper">
                            @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                            {
                                <img src="@product.ImageUrl" alt="@product.Name" class="card-img-top product-card-img" onerror="this.onerror=null; this.src='https://placehold.co/400x300/e9ecef/6c757d?text=No+Image';" />
                            }
                            else
                            {
                                <img src="https://placehold.co/400x300/e9ecef/6c757d?text=@Uri.EscapeDataString(product.Name)" alt="@product.Name" class="card-img-top product-card-img" />
                            }
                        </div>
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title text-dark">@product.Name</h5>
                            <p class="card-text text-success fw-bold fs-5 mb-0 mt-auto">@((product.DefaultSalePrice ?? product.DefaultPurchasePrice).ToString("C", pkrCulture))</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="fas fa-box-open fa-4x text-muted mb-3"></i>
            <p class="text-muted fs-5">No products available at the moment. Please check back later.</p>
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary mt-3"><i class="fas fa-home me-2"></i>Back to Dashboard</a>
        </div>
    }
</div>

<style>
    .product-card {
        border: none;
        overflow: hidden;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .product-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
    }
    .product-card-image-wrapper {
        height: 200px;
        overflow: hidden;
        background: #f8f9fa;
    }
    .product-card-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
</style>
