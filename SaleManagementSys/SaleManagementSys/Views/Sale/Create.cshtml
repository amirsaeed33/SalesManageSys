@model SaleManagementSys.Models.CreateSaleViewModel
@{
    ViewData["Title"] = "Create New Sale";
    var products = ViewBag.Products as List<SaleManagementSys.Models.Product> ?? new List<SaleManagementSys.Models.Product>();
}
@section Styles {
    <link rel="stylesheet" href="~/css/sale.css" asp-append-version="true" />
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-plus-circle me-2"></i>Create New Sale</h2>
        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-secondary btn-cancel"><i class="fas fa-arrow-left me-2"></i>Back to Dashboard</a>
    </div>

    <div class="form-container">
        <form asp-controller="Sale" asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="alert alert-danger mb-3" role="alert"></div>

            <div class="form-section">
                <h3 class="section-title"><i class="fas fa-user me-2"></i>Customer Information</h3>
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="CustomerName" class="form-label"></label>
                        <input asp-for="CustomerName" class="form-control" placeholder="Enter customer name" />
                        <span asp-validation-for="CustomerName" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="PhoneNumber" class="form-label"></label>
                        <input asp-for="PhoneNumber" class="form-control" placeholder="Enter phone number" />
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="form-section">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="section-title mb-0"><i class="fas fa-box me-2"></i>Sale Items</h3>
                    <button type="button" class="btn btn-success btn-add-item" id="addSaleItem"><i class="fas fa-plus me-2"></i>Add Item</button>
                </div>

                <div class="table-responsive">
                    <table class="table table-bordered table-hover" id="saleItemsTable">
                        <thead class="table-light">
                            <tr>
                                <th>Product</th>
                                <th class="text-end">Quantity</th>
                                <th class="text-end">Sale Price</th>
                                <th class="text-end">Purchase Price</th>
                                <th class="text-end">SubTotal</th>
                                <th class="text-center col-action-sm">Action</th>
                            </tr>
                        </thead>
                        <tbody id="saleItemsContainer"></tbody>
                        <tfoot>
                            <tr class="table-info">
                                <th colspan="4" class="text-end"><strong>Grand Total:</strong></th>
                                <th class="text-end" id="grandTotal">0.00</th>
                                <th></th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-secondary btn-cancel">Cancel</a>
                <button type="submit" class="btn btn-primary">Create</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        const products = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(products.Select(p => new { p.Id, p.Name, p.DefaultPurchasePrice })));
        let saleItemIndex = 0;

        function productOptions() {
            let html = '<option value="">-- Select Product --</option>';
            products.forEach(p => {
                html += `<option value="${p.Id}" data-price="${p.DefaultPurchasePrice}">${p.Name}</option>`;
            });
            return html;
        }

        document.getElementById('addSaleItem').addEventListener('click', function() {
            const tbody = document.getElementById('saleItemsContainer');
            const index = saleItemIndex++;
            const row = document.createElement('tr');
            row.setAttribute('data-index', index);
            row.innerHTML = `
                <td>
                    <select name="SaleDetails[${index}].ProductId" class="form-select form-select-sm product-select" required>
                        ${productOptions()}
                    </select>
                </td>
                <td>
                    <input name="SaleDetails[${index}].Quantity" type="number" min="1" class="form-control form-control-sm quantity text-end" value="1" required />
                </td>
                <td>
                    <input name="SaleDetails[${index}].SalePrice" type="number" step="0.01" min="0" class="form-control form-control-sm sale-price text-end" placeholder="0.00" required />
                </td>
                <td>
                    <input name="SaleDetails[${index}].PurchasePrice" type="number" step="0.01" min="0" class="form-control form-control-sm purchase-price text-end" placeholder="0.00" />
                </td>
                <td class="text-end subtotal-cell" data-subtotal="0.00">0.00</td>
                <td class="text-center">
                    <button type="button" class="btn btn-danger btn-sm btn-remove" onclick="removeSaleItem(this)"><i class="fas fa-trash"></i></button>
                </td>
            `;
            tbody.appendChild(row);
            updateIndexes();
            attachCalculationListeners(row);
            row.querySelector('.product-select').addEventListener('change', function() {
                const opt = this.selectedOptions[0];
                if (opt && opt.value) {
                    const price = parseFloat(opt.getAttribute('data-price')) || 0;
                    row.querySelector('.purchase-price').value = price.toFixed(2);
                    calculateTotals();
                }
            });
        });

        function removeSaleItem(button) {
            button.closest('tr').remove();
            updateIndexes();
            calculateTotals();
        }

        function updateIndexes() {
            document.querySelectorAll('#saleItemsContainer tr').forEach((row, index) => {
                row.querySelectorAll('input, select').forEach(input => {
                    if (input.name)
                        input.name = input.name.replace(/SaleDetails\[\d+\]/, `SaleDetails[${index}]`);
                });
                row.setAttribute('data-index', index);
            });
        }

        function attachCalculationListeners(row) {
            [row.querySelector('.quantity'), row.querySelector('.sale-price'), row.querySelector('.purchase-price')].forEach(input => {
                if (input) input.addEventListener('input', () => { calculateRowSubTotal(row); calculateTotals(); });
            });
        }

        function calculateRowSubTotal(row) {
            const qty = parseFloat(row.querySelector('.quantity').value) || 0;
            const price = parseFloat(row.querySelector('.sale-price').value) || 0;
            const subtotal = qty * price;
            const cell = row.querySelector('[data-subtotal]');
            cell.textContent = subtotal.toFixed(2);
            cell.setAttribute('data-subtotal', subtotal.toFixed(2));
        }

        function calculateTotals() {
            let grandTotal = 0;
            document.querySelectorAll('#saleItemsContainer tr').forEach(row => {
                const qty = parseFloat(row.querySelector('.quantity').value) || 0;
                const price = parseFloat(row.querySelector('.sale-price').value) || 0;
                grandTotal += qty * price;
            });
            document.getElementById('grandTotal').textContent = grandTotal.toFixed(2);
        }

        document.addEventListener('DOMContentLoaded', function() {
            if (document.querySelectorAll('#saleItemsContainer tr').length === 0)
                document.getElementById('addSaleItem').click();
        });
    </script>
}
