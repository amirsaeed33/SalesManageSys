@model DashboardViewModel
@{
    ViewData["Title"] = "Sales Management Dashboard";
}
@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<div class="container-fluid px-4">
    <!-- Dashboard Cards Section -->
    <div class="row g-4 mb-4">
        @foreach (var card in Model.Cards)
        {
            <div class="col-md-4 col-sm-6">
                <div class="card dashboard-card @card.GradientCssClass text-white">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <p class="card-label mb-2">@card.Label</p>
                                <h2 class="card-value">@card.Value</h2>
                            </div>
                            <div class="card-icon">
                                <i class="@card.IconCssClass"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        // Add any custom JavaScript here if needed
        $(document).ready(function() {
            // Optional: Add animations or interactions
        });
    </script>
}
