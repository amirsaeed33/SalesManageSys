@model List<SaleManagementSys.Models.Product>
@using System.Globalization
@using System.Text.Json
@using SaleManagementSys.Helpers
@{
    ViewData["Title"] = "Products";
    var pkrCulture = CurrencyHelper.PkrCulture;
}
@section Styles {
    <style>
        .product-image-circle-wrapper { cursor: pointer; }
        .product-image-circle {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 120px;
            height: 120px;
            border-radius: 50%;
            overflow: hidden;
            background: #e9ecef;
            border: 3px solid #dee2e6;
            transition: border-color 0.2s, background 0.2s;
        }
        .product-image-circle-wrapper:hover .product-image-circle {
            border-color: #0d6efd;
            background: #f8f9fa;
        }
        .product-image-circle-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .product-image-placeholder {
            color: #6c757d;
            font-size: 0.85rem;
        }
        .product-image-placeholder i.fa-camera { font-size: 2rem; }
        .product-table-wrapper {
            max-height: calc(100vh - 260px);
            overflow: auto;
        }
        .product-table-wrapper .table { margin-bottom: 0; }
    </style>
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-box me-2"></i>Products</h2>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#productFormModal" onclick="productModal.open();">
            <i class="fas fa-plus me-2"></i>Add Product
        </button>
    </div>

    <div class="mb-3">
        <div class="input-group">
            <span class="input-group-text"><i class="fas fa-search"></i></span>
            <input type="text" id="productSearch" class="form-control" placeholder="Search by name, description, price, stock..." aria-label="Search products" />
        </div>
    </div>

    <div class="table-responsive product-table-wrapper">
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Name</th>
                    <th>Purchase Price</th>
                    <th>Sale Price</th>
                    <th class="text-center">Stock</th>
                    <th>Description</th>
                    <th class="text-center">Active</th>
                    <th class="text-center col-action">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    var i = 1;
                    foreach (var p in Model)
                    {
                        <tr data-id="@p.Id"
                            data-name="@p.Name"
                            data-price="@p.DefaultPurchasePrice.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"
                            data-saleprice="@((p.DefaultSalePrice ?? p.DefaultPurchasePrice).ToString("F2", System.Globalization.CultureInfo.InvariantCulture))"
                            data-stockquantity="@p.StockQuantity"
                            data-imageurl="@(p.ImageUrl ?? "")"
                            data-description="@(p.Description ?? "")"
                            data-active="@(p.IsActive ? "true" : "false")">
                            <td>@i</td>
                            <td>@p.Name</td>
                            <td>@p.DefaultPurchasePrice.ToString("C", pkrCulture)</td>
                            <td>@((p.DefaultSalePrice ?? p.DefaultPurchasePrice).ToString("C", pkrCulture))</td>
                            <td class="text-center">@p.StockQuantity</td>
                            <td>@(p.Description ?? "—")</td>
                            <td class="text-center">
                                @if (p.IsActive)
                                { <span class="badge bg-success">Active</span> }
                                else
                                { <span class="badge bg-secondary">In Active</span> }
                            </td>
                            <td class="text-center">
                                <button type="button" class="btn btn-sm btn-outline-primary me-1" title="Edit" onclick="productModal.open(this.closest('tr'));">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <form id="delete-product-@p.Id" asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="button" class="btn btn-sm btn-danger" title="Delete" onclick="showDeleteConfirm('delete-product-@p.Id', 'Are you sure you want to delete this product?');">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                        i++;
                    }
                }
                else
                {
                    <tr><td colspan="8" class="text-center text-muted">No products. Click "Add Product" to create one.</td></tr>
                }
                <tr id="productNoSearchResults" style="display: none;"><td colspan="8" class="text-center text-muted">No matching products.</td></tr>
            </tbody>
        </table>
    </div>

</div>

<div class="modal fade" id="productFormModal" tabindex="-1" aria-labelledby="productFormModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="productFormModalLabel">
                    <i class="fas fa-box me-2"></i><span id="productFormModalTitle">Add Product</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="productForm" method="post" asp-action="Save" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" id="productId" name="Id" value="0" />
                <input type="hidden" id="productImageUrl" name="ImageUrl" value="" />
                <div class="modal-body">
                    <div class="text-center mb-4">
                        <label class="product-image-circle-wrapper d-inline-block mb-0" id="productImageCircleLabel" for="productImageFile" title="Click to select picture">
                            <span class="product-image-circle" id="productImageCircle">
                                <img id="productImagePreview" src="" alt="" class="product-image-circle-img d-none" />
                                <span id="productImagePlaceholder" class="product-image-placeholder"><i class="fas fa-camera"></i><span class="small d-block mt-1">Select</span></span>
                            </span>
                        </label>
                        <input type="file" id="productImageFile" name="ImageFile" accept="image/*" class="d-none" />
                    </div>
                    <div class="mb-3">
                        <label for="productName" class="form-label">Product Name</label>
                        <input type="text" id="productName" name="Name" class="form-control" required maxlength="200" placeholder="Enter product name" />
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="productPrice" class="form-label">Default Purchase Price</label>
                            <input type="number" id="productPrice" name="DefaultPurchasePrice" class="form-control" step="0.01" min="0" value="0" placeholder="0.00" />
                        </div>
                        <div class="col-md-6">
                            <label for="productSalePrice" class="form-label">Default Sale Price</label>
                            <input type="number" id="productSalePrice" name="DefaultSalePrice" class="form-control" step="0.01" min="0" placeholder="Optional" />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="productStockQuantity" class="form-label">Stock Quantity</label>
                            <input type="number" id="productStockQuantity" name="StockQuantity" class="form-control" min="0" value="0" />
                        </div>
                        <div class="col-md-6 d-flex align-items-end">
                            <div class="form-check mb-2">
                                <input type="checkbox" class="form-check-input" id="productIsActive" name="IsActive" value="true" />
                                <label class="form-check-label" for="productIsActive">Active</label>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="productDescription" class="form-label">Description</label>
                        <textarea id="productDescription" name="Description" class="form-control" rows="2" maxlength="1000" placeholder="Optional"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i><span id="productFormSubmitText">Save</span></button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var modalEl = document.getElementById('productFormModal');
            var titleEl = document.getElementById('productFormModalTitle');
            var submitTextEl = document.getElementById('productFormSubmitText');
            var modalInstance = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);

            function updateProductImageCircle(imageUrl, file) {
                var preview = document.getElementById('productImagePreview');
                var placeholder = document.getElementById('productImagePlaceholder');
                var hiddenUrl = document.getElementById('productImageUrl');
                var fileInput = document.getElementById('productImageFile');
                if (file) {
                    var reader = new FileReader();
                    reader.onload = function (e) {
                        preview.src = e.target.result;
                        preview.classList.remove('d-none');
                        placeholder.classList.add('d-none');
                        hiddenUrl.value = '';
                    };
                    reader.readAsDataURL(file);
                } else if (imageUrl) {
                    preview.src = imageUrl;
                    preview.classList.remove('d-none');
                    placeholder.classList.add('d-none');
                    hiddenUrl.value = imageUrl;
                } else {
                    preview.src = '';
                    preview.classList.add('d-none');
                    placeholder.classList.remove('d-none');
                    hiddenUrl.value = '';
                }
            }

            window.productModal = {
                open: function (row) {
                    var isActiveEl = document.getElementById('productIsActive');
                    if (!row) {
                        document.getElementById('productId').value = '0';
                        document.getElementById('productName').value = '';
                        document.getElementById('productPrice').value = '0';
                        document.getElementById('productSalePrice').value = '';
                        document.getElementById('productStockQuantity').value = '0';
                        document.getElementById('productDescription').value = '';
                        isActiveEl.checked = true;
                        titleEl.textContent = 'Add Product';
                        submitTextEl.textContent = 'Save';
                        updateProductImageCircle('', null);
                    } else {
                        document.getElementById('productId').value = row.dataset.id || '0';
                        document.getElementById('productName').value = row.dataset.name || '';
                        document.getElementById('productPrice').value = row.dataset.price || '0';
                        document.getElementById('productSalePrice').value = row.dataset.saleprice || '';
                        document.getElementById('productStockQuantity').value = row.dataset.stockquantity || '0';
                        document.getElementById('productDescription').value = row.dataset.description || '';
                        isActiveEl.checked = (row.dataset.active || 'true') === 'true';
                        titleEl.textContent = 'Edit Product';
                        submitTextEl.textContent = 'Update';
                        updateProductImageCircle(row.dataset.imageurl || '', null);
                    }
                    document.getElementById('productImageFile').value = '';
                    modalInstance.show();
                }
            };

            document.getElementById('productImageFile').addEventListener('change', function () {
                var file = this.files && this.files[0];
                if (file && file.type.startsWith('image/'))
                    updateProductImageCircle('', file);
            });

            var searchInput = document.getElementById('productSearch');
            var tbody = document.querySelector('.product-table-wrapper tbody');
            var dataRows = tbody ? Array.from(tbody.querySelectorAll('tr')).filter(function (tr) { return tr.cells.length > 1; }) : [];
            var noDataRow = tbody ? tbody.querySelector('tr td[colspan]') : null;

            if (searchInput && tbody) {
                var noSearchRow = document.getElementById('productNoSearchResults');
                searchInput.addEventListener('input', function () {
                    var q = (this.value || '').trim().toLowerCase();
                    var visible = 0;
                    dataRows.forEach(function (row) {
                        var text = (row.textContent || '').toLowerCase();
                        var show = !q || text.indexOf(q) !== -1;
                        row.style.display = show ? '' : 'none';
                        if (show) visible++;
                    });
                    if (noDataRow) {
                        noDataRow.closest('tr').style.display = (dataRows.length === 0) ? '' : 'none';
                    }
                    if (noSearchRow) {
                        noSearchRow.style.display = (dataRows.length > 0 && visible === 0) ? '' : 'none';
                    }
                });
            }

            modalEl.addEventListener('show.bs.modal', function (e) {
                if (e.relatedTarget && e.relatedTarget.getAttribute('data-bs-target') === '#productFormModal')
                    productModal.open();
            });
        })();

        @{
            var reopenId = TempData["ProductId"]?.ToString() ?? "0";
            var reopenName = TempData["ProductName"]?.ToString() ?? "";
            var reopenPrice = TempData["ProductPrice"]?.ToString() ?? "0";
            var reopenSalePrice = TempData["ProductDefaultSalePrice"]?.ToString() ?? "";
            var reopenStock = TempData["ProductStockQuantity"]?.ToString() ?? "0";
            var reopenImageUrl = TempData["ProductImageUrl"]?.ToString() ?? "";
            var reopenDesc = TempData["ProductDescription"]?.ToString() ?? "";
            var reopenActive = TempData["ProductIsActive"] as bool? ?? true;
        }
        @if (!string.IsNullOrEmpty(reopenName))
        {
            <text>
            (function () {
                var row = document.createElement('tr');
                row.dataset.id = @Html.Raw(JsonSerializer.Serialize(reopenId));
                row.dataset.name = @Html.Raw(JsonSerializer.Serialize(reopenName));
                row.dataset.price = @Html.Raw(JsonSerializer.Serialize(reopenPrice));
                row.dataset.saleprice = @Html.Raw(JsonSerializer.Serialize(reopenSalePrice));
                row.dataset.stockquantity = @Html.Raw(JsonSerializer.Serialize(reopenStock));
                row.dataset.imageurl = @Html.Raw(JsonSerializer.Serialize(reopenImageUrl));
                row.dataset.description = @Html.Raw(JsonSerializer.Serialize(reopenDesc));
                row.dataset.active = @Html.Raw(JsonSerializer.Serialize(reopenActive));
                productModal.open(row);
            })();
            </text>
        }
    </script>
}
