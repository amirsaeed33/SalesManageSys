@model List<SaleManagementSys.Models.Product>
@using System.Globalization
@{
    ViewData["Title"] = "Products";
    var pkrCulture = CultureInfo.GetCultureInfo("en-PK");
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0"><i class="fas fa-store me-2"></i>Our Products</h2>
        <div class="d-flex gap-2 btn-cart d-none" id="cartButtons">
            <button type="button" class="btn btn-outline-danger" id="btnCancelOrder" title="Cancel and clear current order">
                <i class="fas fa-times me-2"></i>Cancel Order
            </button>
            <button type="button" class="btn btn-primary" id="btnPlaceOrder">
                <i class="fas fa-shopping-cart me-2"></i>Place Order <span id="cartCount" class="badge bg-light text-dark ms-1">0</span>
            </button>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            @foreach (var product in Model)
            {
                var salePrice = product.DefaultSalePrice ?? product.DefaultPurchasePrice;
                <div class="col-md-4 col-sm-6 col-lg-3">
                    <div class="card product-card h-100 shadow-sm" data-product-id="@product.Id" data-product-name="@product.Name" data-sale-price="@salePrice.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" data-purchase-price="@product.DefaultPurchasePrice.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)">
                        <div class="product-card-image-wrapper catalog-img-open" role="button" tabindex="0" title="Click to open / zoom picture" data-img-src="@(string.IsNullOrWhiteSpace(product.ImageUrl) ? "https://placehold.co/400x300/e9ecef/6c757d?text=" + Uri.EscapeDataString(product.Name) : product.ImageUrl)" data-img-alt="@product.Name">
                            @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                            {
                                <img src="@product.ImageUrl" alt="@product.Name" class="card-img-top product-card-img" onerror="this.onerror=null; this.src='https://placehold.co/400x300/e9ecef/6c757d?text=No+Image';" />
                            }
                            else
                            {
                                <img src="https://placehold.co/400x300/e9ecef/6c757d?text=@Uri.EscapeDataString(product.Name)" alt="@product.Name" class="card-img-top product-card-img" />
                            }
                            <span class="catalog-img-hint"><i class="fas fa-search-plus"></i> Open</span>
                        </div>
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title text-dark">@product.Name</h5>
                            <p class="card-text text-success fw-bold fs-5 mb-2">@salePrice.ToString("C", pkrCulture)</p>
                            <button type="button" class="btn btn-success btn-add-order mt-auto">
                                <i class="fas fa-plus me-1"></i>Add to Order
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="fas fa-box-open fa-4x text-muted mb-3"></i>
            <p class="text-muted fs-5">No products available at the moment. Please check back later.</p>
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary mt-3"><i class="fas fa-home me-2"></i>Back to Dashboard</a>
        </div>
    }
</div>

<!-- Place Order Modal -->
<div class="modal fade" id="placeOrderModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-shopping-bag me-2"></i>Place Your Order</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="placeOrderForm">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Customer Name <span class="text-danger">*</span></label>
                            <input type="text" name="CustomerName" id="orderCustomerName" class="form-control" required placeholder="Your name" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Phone Number</label>
                            <input type="text" name="PhoneNumber" id="orderPhoneNumber" class="form-control" placeholder="Your phone" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Address</label>
                        <textarea name="Address" id="orderAddress" class="form-control" rows="2" placeholder="Delivery / billing address (optional)"></textarea>
                    </div>
                    <div id="orderCartEmpty" class="alert alert-secondary text-center d-none mb-0">No items in your order. Add products from the catalog.</div>
                    <div class="table-responsive" id="orderCartTable">
                        <table class="table table-bordered">
                            <thead><tr><th>Product</th><th class="text-end">Qty</th><th class="text-end">Price</th><th class="text-end">Subtotal</th><th></th></tr></thead>
                            <tbody id="orderCartBody"></tbody>
                            <tfoot><tr><th colspan="3" class="text-end">Grand Total:</th><th class="text-end" id="orderGrandTotal">0.00</th><th></th></tr></tfoot>
                        </table>
                    </div>
                    <div id="orderSuccess" class="alert alert-success d-none"></div>
                    <div id="orderError" class="alert alert-danger d-none"></div>
                </div>
                <div class="modal-footer" id="placeOrderModalFooter">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="btnSubmitOrder">
                        <i class="fas fa-check me-1"></i>Place Order
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Image viewer modal (zoom / open picture) -->
<div class="modal fade" id="imageViewerModal" tabindex="-1" aria-labelledby="imageViewerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl modal-fullscreen-md-down">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h5 class="modal-title" id="imageViewerModalLabel"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-2 image-viewer-body">
                <div class="image-viewer-wrap">
                    <img id="imageViewerImg" src="" alt="" class="image-viewer-img" />
                </div>
            </div>
            <div class="modal-footer py-2 justify-content-center flex-wrap gap-2">
                <button type="button" class="btn btn-outline-secondary btn-sm" id="imageViewerZoomOut" title="Zoom out"><i class="fas fa-search-minus me-1"></i>Zoom out</button>
                <button type="button" class="btn btn-outline-secondary btn-sm" id="imageViewerZoomReset" title="Reset zoom">Reset</button>
                <button type="button" class="btn btn-outline-secondary btn-sm" id="imageViewerZoomIn" title="Zoom in"><i class="fas fa-search-plus me-1"></i>Zoom in</button>
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<style>
    .product-card-image-wrapper.catalog-img-open {
        cursor: pointer;
        position: relative;
    }
    .catalog-img-hint {
        position: absolute;
        bottom: 6px;
        right: 8px;
        background: rgba(0,0,0,0.6);
        color: #fff;
        font-size: 0.75rem;
        padding: 2px 8px;
        border-radius: 4px;
        opacity: 0;
        transition: opacity 0.2s;
    }
    .product-card-image-wrapper.catalog-img-open:hover .catalog-img-hint { opacity: 1; }
    .image-viewer-body {
        min-height: 280px;
        height: 70vh;
        max-height: calc(100vh - 180px);
        overflow: auto;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #1a1a1a;
    }
    .image-viewer-wrap {
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 100%;
        min-height: 100%;
    }
    .image-viewer-img {
        max-width: 100%;
        max-height: 100%;
        width: auto;
        height: auto;
        object-fit: contain;
        transition: width 0.15s ease, height 0.15s ease;
    }
    .product-card {
        border: none;
        overflow: hidden;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .product-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
    }
    .product-card-image-wrapper {
        height: 200px;
        overflow: hidden;
        background: #f8f9fa;
    }
    .product-card-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .btn-add-order { width: 100%; }
</style>

@section Scripts {
<script>
(function() {
    var CART_KEY = 'store_cart';
    var createOrderUrl = '@Url.Action("Create", "Order")';

    function getCart() {
        try {
            var json = localStorage.getItem(CART_KEY);
            return json ? JSON.parse(json) : [];
        } catch (e) { return []; }
    }

    function saveCart(items) {
        localStorage.setItem(CART_KEY, JSON.stringify(items));
        updateCartUI();
    }

    function addToCart(productId, name, salePrice, purchasePrice, qty) {
        qty = qty || 1;
        var cart = getCart();
        var existing = cart.find(function(x) { return x.productId === productId; });
        if (existing) existing.quantity += qty;
        else cart.push({ productId: productId, name: name, salePrice: parseFloat(salePrice), purchasePrice: parseFloat(purchasePrice), quantity: qty });
        saveCart(cart);
    }

    function removeFromCart(productId) {
        var cart = getCart().filter(function(x) { return x.productId !== productId; });
        saveCart(cart);
        renderOrderTable();
        if (cart.length === 0) {
            var modal = bootstrap.Modal.getInstance(document.getElementById('placeOrderModal'));
            if (modal) modal.hide();
        }
    }

    function updateCartUI() {
        var cart = getCart();
        var count = cart.reduce(function(s, x) { return s + x.quantity; }, 0);
        var container = document.getElementById('cartButtons');
        var badge = document.getElementById('cartCount');
        if (container) {
            if (count > 0) {
                container.classList.remove('d-none');
                container.classList.add('d-flex');
            } else {
                container.classList.add('d-none');
                container.classList.remove('d-flex');
            }
        }
        if (badge) {
            badge.textContent = count;
        }
    }

    function renderOrderTable() {
        var cart = getCart();
        var tbody = document.getElementById('orderCartBody');
        var totalEl = document.getElementById('orderGrandTotal');
        var cartTable = document.getElementById('orderCartTable');
        var cartEmpty = document.getElementById('orderCartEmpty');
        var modalFooter = document.getElementById('placeOrderModalFooter');
        if (!tbody || !totalEl) return;
        if (cart.length === 0) {
            if (cartTable) cartTable.classList.add('d-none');
            if (cartEmpty) cartEmpty.classList.remove('d-none');
            if (modalFooter) modalFooter.classList.add('d-none');
            tbody.innerHTML = '';
            totalEl.textContent = '0.00';
            return;
        }
        if (cartTable) cartTable.classList.remove('d-none');
        if (cartEmpty) cartEmpty.classList.add('d-none');
        if (modalFooter) modalFooter.classList.remove('d-none');
        var total = 0;
        tbody.innerHTML = '';
        cart.forEach(function(item) {
            var subtotal = item.quantity * item.salePrice;
            total += subtotal;
            var tr = document.createElement('tr');
            tr.innerHTML = '<td>' + (item.name || '') + '</td>' +
                '<td class="text-end">' + item.quantity + '</td>' +
                '<td class="text-end">' + item.salePrice.toFixed(2) + '</td>' +
                '<td class="text-end">' + subtotal.toFixed(2) + '</td>' +
                '<td><button type="button" class="btn btn-sm btn-outline-danger remove-cart-item" data-id="' + item.productId + '"><i class="fas fa-trash"></i></button></td>';
            tbody.appendChild(tr);
        });
        totalEl.textContent = total.toFixed(2);
        tbody.querySelectorAll('.remove-cart-item').forEach(function(btn) {
            btn.addEventListener('click', function() { removeFromCart(parseInt(this.getAttribute('data-id'))); });
        });
    }

    document.querySelectorAll('.btn-add-order').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
            e.stopPropagation();
            var card = this.closest('.product-card');
            if (!card) return;
            addToCart(
                parseInt(card.dataset.productId),
                card.dataset.productName || '',
                card.dataset.salePrice || '0',
                card.dataset.purchasePrice || '0',
                1
            );
        });
    });

    // Image viewer: open picture and zoom
    var imageViewerModal = document.getElementById('imageViewerModal');
    var imageViewerImg = document.getElementById('imageViewerImg');
    var imageViewerLabel = document.getElementById('imageViewerModalLabel');
    var imageViewerBody = document.querySelector('.image-viewer-body');
    var imageViewerZoom = 1;
    var imageViewerBaseW = 0;
    var imageViewerBaseH = 0;
    var minZoom = 0.25;
    var maxZoom = 4;
    var zoomStep = 0.25;

    function applyImageViewerZoom() {
        if (!imageViewerImg || !imageViewerBaseW || !imageViewerBaseH) return;
        var w = Math.round(imageViewerBaseW * imageViewerZoom);
        var h = Math.round(imageViewerBaseH * imageViewerZoom);
        imageViewerImg.style.width = w + 'px';
        imageViewerImg.style.height = h + 'px';
        imageViewerImg.style.maxWidth = 'none';
        imageViewerImg.style.maxHeight = 'none';
    }

    function setImageViewerZoom(z) {
        imageViewerZoom = Math.max(minZoom, Math.min(maxZoom, z));
        applyImageViewerZoom();
    }

    function fitImageToViewer() {
        if (!imageViewerImg || !imageViewerBody) return;
        var nw = imageViewerImg.naturalWidth;
        var nh = imageViewerImg.naturalHeight;
        if (!nw || !nh) return;
        var cw = imageViewerBody.clientWidth;
        var ch = imageViewerBody.clientHeight;
        var fit = Math.min(cw / nw, ch / nh, 1);
        imageViewerBaseW = nw * fit;
        imageViewerBaseH = nh * fit;
        imageViewerZoom = 1;
        applyImageViewerZoom();
    }

    document.querySelectorAll('.catalog-img-open').forEach(function(el) {
        el.addEventListener('click', function() {
            var src = this.getAttribute('data-img-src');
            var alt = this.getAttribute('data-img-alt') || '';
            if (!imageViewerImg || !src) return;
            imageViewerImg.style.maxWidth = '';
            imageViewerImg.style.maxHeight = '';
            imageViewerImg.style.width = '';
            imageViewerImg.style.height = '';
            imageViewerImg.src = src;
            imageViewerImg.alt = alt;
            if (imageViewerLabel) imageViewerLabel.textContent = alt;
            imageViewerZoom = 1;
            imageViewerBaseW = 0;
            imageViewerBaseH = 0;
            var modal = new bootstrap.Modal(imageViewerModal);
            modal.show();
        });
        el.addEventListener('keydown', function(e) {
            if (e.key === 'Enter' || e.key === ' ') {
                e.preventDefault();
                this.click();
            }
        });
    });

    if (imageViewerImg) {
        imageViewerImg.addEventListener('load', function() {
            fitImageToViewer();
        });
    }

    if (imageViewerModal) {
        imageViewerModal.addEventListener('shown.bs.modal', function() {
            if (imageViewerImg.complete && imageViewerImg.naturalWidth) fitImageToViewer();
        });
        document.getElementById('imageViewerZoomIn').addEventListener('click', function() { setImageViewerZoom(imageViewerZoom + zoomStep); });
        document.getElementById('imageViewerZoomOut').addEventListener('click', function() { setImageViewerZoom(imageViewerZoom - zoomStep); });
        document.getElementById('imageViewerZoomReset').addEventListener('click', function() { setImageViewerZoom(1); });
        imageViewerModal.addEventListener('wheel', function(e) {
            if (!e.target.closest('.image-viewer-body')) return;
            e.preventDefault();
            var delta = e.deltaY > 0 ? -zoomStep : zoomStep;
            setImageViewerZoom(imageViewerZoom + delta);
        }, { passive: false });
    }

    document.getElementById('btnCancelOrder').addEventListener('click', function() {
        saveCart([]);
        var placeModal = document.getElementById('placeOrderModal');
        var modalInstance = bootstrap.Modal.getInstance(placeModal);
        if (modalInstance) modalInstance.hide();
    });

    document.getElementById('btnPlaceOrder').addEventListener('click', function() {
        renderOrderTable();
        document.getElementById('orderSuccess').classList.add('d-none');
        document.getElementById('orderError').classList.add('d-none');
        var modal = new bootstrap.Modal(document.getElementById('placeOrderModal'));
        modal.show();
    });

    document.getElementById('placeOrderForm').addEventListener('submit', function(e) {
        e.preventDefault();
        var cart = getCart();
        if (cart.length === 0) {
            document.getElementById('orderError').textContent = 'Your order is empty.';
            document.getElementById('orderError').classList.remove('d-none');
            return;
        }
        var customerName = document.getElementById('orderCustomerName').value.trim();
        if (!customerName) {
            document.getElementById('orderError').textContent = 'Please enter your name.';
            document.getElementById('orderError').classList.remove('d-none');
            return;
        }

        var formData = new FormData();
        formData.append('CustomerName', customerName);
        formData.append('PhoneNumber', document.getElementById('orderPhoneNumber').value.trim() || '');
        formData.append('Address', document.getElementById('orderAddress').value.trim() || '');
        formData.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);

        cart.forEach(function(item, i) {
            formData.append('OrderDetails[' + i + '].ProductId', item.productId);
            formData.append('OrderDetails[' + i + '].Quantity', item.quantity);
            formData.append('OrderDetails[' + i + '].SalePrice', item.salePrice);
            formData.append('OrderDetails[' + i + '].PurchasePrice', item.purchasePrice);
        });

        var submitBtn = document.getElementById('btnSubmitOrder');
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Placing...';

        fetch(createOrderUrl, {
            method: 'POST',
            body: formData,
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(function(r) { return r.json().catch(function() { return { success: false, errors: [{ message: 'Invalid response' }] }; }); })
        .then(function(data) {
            if (data.success) {
                saveCart([]);
                document.getElementById('orderSuccess').textContent = 'Order placed successfully! Thank you for your order.';
                document.getElementById('orderSuccess').classList.remove('d-none');
                document.getElementById('orderError').classList.add('d-none');
                submitBtn.disabled = true;
                document.getElementById('orderCustomerName').readOnly = true;
                document.getElementById('orderPhoneNumber').readOnly = true;
                setTimeout(function() {
                    bootstrap.Modal.getInstance(document.getElementById('placeOrderModal')).hide();
                    document.getElementById('placeOrderForm').reset();
                    document.getElementById('orderCustomerName').readOnly = false;
                    document.getElementById('orderPhoneNumber').readOnly = false;
                }, 2000);
            } else {
                document.getElementById('orderError').textContent = (data.errors && data.errors[0] && data.errors[0].message) || 'Failed to place order. Please try again.';
                document.getElementById('orderError').classList.remove('d-none');
            }
        })
        .catch(function() {
            document.getElementById('orderError').textContent = 'Failed to place order. Please try again.';
            document.getElementById('orderError').classList.remove('d-none');
        })
        .finally(function() {
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<i class="fas fa-check me-1"></i>Place Order';
        });
    });

    updateCartUI();
})();
</script>
}
