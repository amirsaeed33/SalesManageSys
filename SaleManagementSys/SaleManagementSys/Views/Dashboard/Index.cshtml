@model DashboardViewModel
@{
    ViewData["Title"] = "Sales Management Dashboard";
}
@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<div class="container-fluid px-4">
    <!-- Dashboard Cards Section -->
    <div class="row g-4 mb-4">
        @foreach (var card in Model.Cards)
        {
            <div class="col-md-4 col-sm-6">
                <div class="card dashboard-card @card.GradientCssClass text-white">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <p class="card-label mb-2">@card.Label</p>
                                <h2 class="card-value">@card.Value</h2>
                            </div>
                            <div class="card-icon">
                                <i class="@card.IconCssClass"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Sales Table Section -->
    <div class="sales-table-container">
        <h3 class="mb-4">
            <i class="fas fa-list me-2"></i>Sales Records
        </h3>
        <div class="table-responsive">
            <table class="table table-striped table-hover table-bordered">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Customer Name</th>
                        <th>Phone</th>
                        <th>Total Amount</th>
                        <th>Total Profit</th>
                        <th>Sale Date</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model?.Sales != null && Model.Sales.Any())
                    {
                        var index = 1;
                        @foreach (var sale in Model.Sales)
                        {
                            <tr>
                                <td>@index</td>
                                <td>@(sale?.CustomerName ?? "N/A")</td>
                                <td>@(sale?.PhoneNumber ?? "N/A")</td>
                                <td class="fw-bold text-success">@(sale?.TotalAmount.ToString("C") ?? "$0.00")</td>
                                <td class="fw-bold text-primary">@(sale?.TotalProfit.ToString("C") ?? "$0.00")</td>
                                <td>@(sale?.SaleDate.ToString("MM/dd/yyyy") ?? "N/A")</td>
                            </tr>
                            index++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4">
                                <i class="fas fa-inbox fa-3x text-muted mb-3 d-block"></i>
                                <p class="text-muted">No sales records found. Create your first sale!</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Add any custom JavaScript here if needed
        $(document).ready(function() {
            // Optional: Add animations or interactions
        });
    </script>
}
